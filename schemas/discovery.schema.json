{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sketchup-agent/schemas/discovery.schema.json",
  "title": "SketchUp Discovery",
  "type": "object",
  "additionalProperties": false,
  "required": ["intent", "objects", "constraints", "ambiguities"],
  "properties": {
    "intent": { "type": "string", "minLength": 1 },
    "objects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "minLength": 1 },
          "name": { "type": "string" },
          "dimensions_mm": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "width": { "type": "number", "exclusiveMinimum": 0 },
              "depth": { "type": "number", "exclusiveMinimum": 0 },
              "height": { "type": "number", "exclusiveMinimum": 0 }
            }
          },
          "position_mm": {
            "type": "object",
            "additionalProperties": false,
            "required": ["x", "y", "z"],
            "properties": {
              "x": { "type": "number" },
              "y": { "type": "number" },
              "z": { "type": "number" }
            }
          },
          "material": { "type": "string" },
          "relations": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "constraints": {
      "type": "array",
      "items": { "type": "string" }
    },
    "ambiguities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "question"],
        "properties": {
          "field": { "type": "string" },
          "question": { "type": "string" },
          "blocking": { "type": "boolean", "default": false }
        }
      }
    }
  }
}
